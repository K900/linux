From 668aabc6b2d10612256c71261e49fe7eb7d6d563 Mon Sep 17 00:00:00 2001
From: Ben Greear <greearb@candelatech.com>
Date: Mon, 9 Feb 2026 17:06:26 -0800
Subject: [PATCH 1/3] skbuff: SKB UAF debugging and sanity checks

Signed-off-by: Ben Greear <greearb@candelatech.com>
---
 include/linux/skbuff.h |  4 ++++
 net/core/skbuff.c      | 53 +++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 56 insertions(+), 1 deletion(-)

diff --git a/include/linux/skbuff.h b/include/linux/skbuff.h
index 1b2dde10c4b7..39124f050d19 100644
--- a/include/linux/skbuff.h
+++ b/include/linux/skbuff.h
@@ -1034,6 +1034,10 @@ struct sk_buff {
 #if defined(CONFIG_NET_SCHED) || defined(CONFIG_NET_XGRESS)
 	__u16			tc_index;	/* traffic control index */
 #endif
+	/* 0x86 means we have freed this skb and should not be using it.  0x97 means in use. */
+#define SKB_ALREADY_FREED     0x86
+#define SKB_ALREADY_ALLOCATED 0x97
+	__u8			free_status;
 
 	u16			alloc_cpu;
 
diff --git a/net/core/skbuff.c b/net/core/skbuff.c
index 17a89adb1b0a..bc2fe8aa0ec6 100644
--- a/net/core/skbuff.c
+++ b/net/core/skbuff.c
@@ -405,6 +405,7 @@ static inline void __finalize_skb_around(struct sk_buff *skb, void *data,
 	/* make sure we initialize shinfo sequentially */
 	shinfo = skb_shinfo(skb);
 	memset(shinfo, 0, offsetof(struct skb_shared_info, dataref));
+	skb->free_status = SKB_ALREADY_ALLOCATED;
 	atomic_set(&shinfo->dataref, 1);
 
 	skb_set_kcov_handle(skb, kcov_common_handle());
@@ -495,6 +496,7 @@ struct sk_buff *__build_skb(void *data, unsigned int frag_size)
 		return NULL;
 
 	skbuff_clear(skb);
+	skb->free_status = SKB_ALREADY_ALLOCATED;
 	__build_skb_around(skb, data, frag_size);
 
 	return skb;
@@ -556,6 +558,7 @@ static struct sk_buff *__napi_build_skb(void *data, unsigned int frag_size)
 		return NULL;
 
 	skbuff_clear(skb);
+	skb->free_status = SKB_ALREADY_ALLOCATED;
 	__build_skb_around(skb, data, frag_size);
 
 	return skb;
@@ -711,8 +714,11 @@ struct sk_buff *__alloc_skb(unsigned int size, gfp_t gfp_mask,
 	 * Both skb->head and skb_shared_info are cache line aligned.
 	 */
 	data = kmalloc_reserve(&size, gfp_mask, node, skb);
-	if (unlikely(!data))
+	if (unlikely(!data)) {
+		skb->free_status = SKB_ALREADY_ALLOCATED; /* quieten debugging */
 		goto nodata;
+	}
+
 	/* kmalloc_size_roundup() might give us more room than requested.
 	 * Put skb_shared_info exactly at the end of allocated zone,
 	 * to allow max possible filling before reallocation.
@@ -738,6 +744,12 @@ struct sk_buff *__alloc_skb(unsigned int size, gfp_t gfp_mask,
 	return skb;
 
 nodata:
+	if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+		pr_err("skb-alloc free-status: 0x%x != 0x%x\n",
+		       skb->free_status, SKB_ALREADY_ALLOCATED);
+		return NULL;
+	}
+	skb->free_status = SKB_ALREADY_FREED;
 	kmem_cache_free(cache, skb);
 	return NULL;
 }
@@ -1145,6 +1157,12 @@ static void kfree_skbmem(struct sk_buff *skb)
 
 	switch (skb->fclone) {
 	case SKB_FCLONE_UNAVAILABLE:
+		if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+			pr_err("kfree-skbmem free-status: 0x%x != 0x%x\n",
+			       skb->free_status, SKB_ALREADY_ALLOCATED);
+			return;
+		}
+		skb->free_status = SKB_ALREADY_FREED;
 		kmem_cache_free(net_hotdata.skbuff_cache, skb);
 		return;
 
@@ -1195,6 +1213,11 @@ void skb_release_head_state(struct sk_buff *skb)
 /* Free everything but the sk_buff shell. */
 static void skb_release_all(struct sk_buff *skb, enum skb_drop_reason reason)
 {
+	if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+		pr_err("skb-release-all free-status: 0x%x != 0x%x\n",
+		       skb->free_status, SKB_ALREADY_ALLOCATED);
+		return;
+	}
 	skb_release_head_state(skb);
 	if (likely(skb->head))
 		skb_release_data(skb, reason);
@@ -1270,7 +1293,15 @@ static void kfree_skb_add_bulk(struct sk_buff *skb,
 		return;
 	}
 
+	if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+		pr_err("kfree-skb-add-bulk free-status: 0x%x != 0x%x\n",
+		       skb->free_status, SKB_ALREADY_ALLOCATED);
+		return;
+	}
 	skb_release_all(skb, reason);
+#ifndef CONFIG_KASAN
+	skb->free_status = SKB_ALREADY_FREED;
+#endif
 	sa->skb_array[sa->skb_count++] = skb;
 
 	if (unlikely(sa->skb_count == KFREE_SKB_BULK_SIZE)) {
@@ -1470,8 +1501,19 @@ static void napi_skb_cache_put(struct sk_buff *skb)
 	if (!kasan_mempool_poison_object(skb))
 		return;
 
+#ifndef CONFIG_KASAN
+	if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+		pr_err("napi-skb-cache-put free-status: 0x%x != 0x%x\n",
+		       skb->free_status, SKB_ALREADY_ALLOCATED);
+		return;
+	}
+#endif
+
 	local_lock_nested_bh(&napi_alloc_cache.bh_lock);
 	nc->skb_cache[nc->skb_count++] = skb;
+#ifndef CONFIG_KASAN
+	skb->free_status = SKB_ALREADY_FREED;
+#endif
 
 	if (unlikely(nc->skb_count == NAPI_SKB_CACHE_SIZE)) {
 		u32 i, remaining = NAPI_SKB_CACHE_SIZE - NAPI_SKB_CACHE_FREE;
@@ -2119,6 +2161,7 @@ struct sk_buff *skb_clone(struct sk_buff *skb, gfp_t gfp_mask)
 			return NULL;
 
 		n->fclone = SKB_FCLONE_UNAVAILABLE;
+		n->free_status = SKB_ALREADY_ALLOCATED;
 	}
 
 	return __skb_clone(n, skb);
@@ -6148,7 +6191,15 @@ EXPORT_SYMBOL(__skb_warn_lro_forwarding);
 void kfree_skb_partial(struct sk_buff *skb, bool head_stolen)
 {
 	if (head_stolen) {
+		if (WARN_ON_ONCE(skb->free_status != SKB_ALREADY_ALLOCATED)) {
+			pr_err("kfree-skb-partial free-status: 0x%x != 0x%x\n",
+			       skb->free_status, SKB_ALREADY_ALLOCATED);
+			return;
+		}
 		skb_release_head_state(skb);
+#ifndef CONFIG_KASAN
+		skb->free_status = SKB_ALREADY_FREED;
+#endif
 		kmem_cache_free(net_hotdata.skbuff_cache, skb);
 	} else {
 		__kfree_skb(skb);
-- 
2.52.0

